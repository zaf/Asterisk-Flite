;
; Flite Configuration
;
[general]
;
; Use cache (yes, no - defaults to no)
;
;usecache=yes
;
; If usecache=yes, a directory to store waveform cache files.
; The cache is never cleared (yet), so you must take care of cleaning it
; yourself (just delete any or all files from the cache).
; The directory is created (mode 0700) if missing. It MUST be owned by the
; asterisk user and MUST NOT be group or world writable, otherwise caching
; is disabled (a shared directory would allow other local users to inject
; audio into your calls). Cached prompts are stored on disk unencrypted;
; avoid caching if your prompts contain sensitive data.
; Defaults to /var/lib/asterisk/flitecache
;
;cachedir=/var/lib/asterisk/flitecache
;
; Voice name (defaults to kal)
; 
; Available voices (for flite 1.4):
;	kal (American male)
;	rms (American male)
;	awb (Scottish male)
;	slt (American female)
;
;voice=kal
;
; Target sample rate for the generated sound files in Hz (default is 8000)
; For now app_flite supports generation of 8000Hz or 16000Hz sound files
; so possible values are only 8000 and 16000. If set to another value it will
; automatically fall back to 8000Hz.
;
;samplerate=16000
;
; Maximum length of the text argument in bytes, 1 to 32768.
; Longer requests are rejected. (default is 4096)
;
;maxtext=4096
;
; NOTE: when the selected voice's native rate differs from 'samplerate',
; flite's resampler adds ~110-250ms of trailing silence to each prompt
; (cached prompts included). For exact-length audio use kal at 8000 or
; kal16 (voice=kal, samplerate=16000).
